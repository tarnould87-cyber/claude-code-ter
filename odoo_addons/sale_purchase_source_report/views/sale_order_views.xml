<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_purchase_source" model="ir.ui.view">
        <field name="name">sale.order.form.purchase.source</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button type="object"
                        name="action_view_linked_purchase_orders"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="purchase_order_source_count == 0">
                    <field name="purchase_order_source_count" widget="statinfo" string="Achats liés"/>
                </button>
            </div>
            <notebook position="inside">
                <page string="Achats liés" name="linked_purchases">
                    <field name="x_studio_purchase_order_ids" readonly="1">
                        <list>
                            <field name="name" string="N° commande fournisseur"/>
                            <field name="partner_id" string="Fournisseur"/>
                            <field name="state" string="Statut"/>
                            <field name="date_order" string="Date confirmation"/>
                            <field name="date_planned" string="Arrivée prévue"/>
                            <field name="amount_untaxed" string="Montant HT" sum="Total"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
