<data>

  <data>
    <xpath position="replace"
           expr="/t[@t-name='sale.report_saleorder_document_copy_10']//t[@t-call='web.external_layout']/t[4]/t[@t-set='information_block']"
           meta-t-set="information_block"/>
    <xpath position="inside"
           expr="/t[@t-name='sale.report_saleorder_document_copy_10']//t[@t-call='web.external_layout']/t[4]"
           meta-t-if="doc.partner_shipping_id == doc.partner_invoice_id and doc.partner_invoice_id != doc.partner_id or doc.partner_shipping_id != doc.partner_invoice_id">
      <t t-set="information_block">
        <div style="font-family: Verdana, Geneva, sans-serif; font-size: 8.5pt; line-height: 1.5; min-width: 170px;">
          <div style="font-family: 'Century Gothic', Trebuchet MS, Arial, sans-serif; font-size: 7pt; color: #949494; text-transform: uppercase; letter-spacing: 2px; font-weight: bold; margin-bottom: 3px;">
            <t t-if="doc.state in ('sale', 'done')">Bon de Commande</t>
            <t t-else="">Devis</t>
          </div>
          <div style="font-family: 'Century Gothic', Trebuchet MS, Arial, sans-serif; font-size: 16pt; font-weight: bold; color: #253758; letter-spacing: 0.5px; margin-bottom: 2px;">
            <span t-field="doc.name"/>
          </div>
          <div style="border-top: 2px solid #C81628; width: 40px; margin-bottom: 10px;"></div>
          <table style="border-collapse: collapse; width: 100%; font-size: 8pt;">
            <tr>
              <td style="font-family: 'Century Gothic', Trebuchet MS, Arial, sans-serif; font-size: 7pt; color: #949494; text-transform: uppercase; letter-spacing: 0.5px; padding: 2px 10px 2px 0; white-space: nowrap;">Date</td>
              <td style="font-weight: bold; color: #252525; white-space: nowrap;"><span t-field="doc.date_order" t-options='{"widget": "date"}'/></td>
            </tr>
            <t t-if="doc.validity_date">
              <tr>
                <td style="font-family: 'Century Gothic', Trebuchet MS, Arial, sans-serif; font-size: 7pt; color: #949494; text-transform: uppercase; letter-spacing: 0.5px; padding: 2px 10px 2px 0; white-space: nowrap;">Validite</td>
                <td style="font-weight: bold; color: #252525; white-space: nowrap;"><span t-field="doc.validity_date"/></td>
              </tr>
            </t>
            <t t-if="doc.client_order_ref">
              <tr>
                <td style="font-family: 'Century Gothic', Trebuchet MS, Arial, sans-serif; font-size: 7pt; color: #949494; text-transform: uppercase; letter-spacing: 0.5px; padding: 2px 10px 2px 0; white-space: nowrap;">Votre ref.</td>
                <td style="font-weight: bold; color: #C81628; white-space: nowrap;"><span t-field="doc.client_order_ref"/></td>
              </tr>
            </t>
            <t t-if="doc.user_id">
              <tr>
                <td style="font-family: 'Century Gothic', Trebuchet MS, Arial, sans-serif; font-size: 7pt; color: #949494; text-transform: uppercase; letter-spacing: 0.5px; padding: 2px 10px 2px 0; white-space: nowrap;">Contact</td>
                <td style="font-weight: bold; color: #252525;"><span t-field="doc.user_id"/></td>
              </tr>
            </t>
          </table>
        </div>
      </t>
    </xpath>
  </data>

  <data>
    <xpath position="inside"
           expr="/t[@t-name='sale.report_saleorder_document_copy_10']//t[@t-call='web.external_layout']/div/div"
           meta-class="oe_structure">
      <style type="text/css">
        .page { font-family: Verdana, Geneva, sans-serif !important; font-size: 8.5pt; color: #252525; }
        .page table thead th, .page table thead td { background-color: #253758 !important; color: #F4F1EA !important; font-family: 'Century Gothic', Trebuchet MS, Arial, sans-serif !important; text-transform: uppercase !important; font-size: 7pt !important; letter-spacing: 1px !important; padding: 9px 10px !important; border: none !important; border-bottom: 2px solid #C81628 !important; }
        .page table tbody tr:nth-child(odd) { background-color: #FFFFFF; }
        .page table tbody tr:nth-child(even) { background-color: #F4F1EA; }
        .page table tbody td { border-bottom: 1px solid #D2CCC2 !important; padding: 7px 10px !important; vertical-align: top; }
        .page .o_subtotal td, .page tr.o_subtotal td { background-color: #F4F1EA !important; font-weight: bold; }
        .page .o_total td, .page tr.o_total td { background-color: #253758 !important; color: #F4F1EA !important; font-family: 'Century Gothic', Trebuchet MS, Arial, sans-serif !important; font-weight: bold !important; font-size: 11pt !important; text-transform: uppercase; border-top: 2px solid #C81628 !important; border-bottom: none !important; padding: 10px 12px !important; }
        .ter-lbl { font-family: 'Century Gothic', Trebuchet MS, Arial, sans-serif; font-size: 7pt; color: #253758; text-transform: uppercase; font-weight: bold; letter-spacing: 1px; display: block; margin-bottom: 2px; }
      </style>
      <div style="border-top: 4px solid #253758; margin: 6px 0 0 0;"></div>
      <div style="border-top: 1.5px solid #C81628; margin: 0 0 18px 0;"></div>
    </xpath>
  </data>

  <data>
    <xpath position="replace"
           expr="/t[@t-name='sale.report_saleorder_document_copy_10']//t[@t-call='web.external_layout']/div/div[3]">
      <div style="background-color: #F4F1EA; border: 1px solid #D2CCC2; border-left: 5px solid #253758; padding: 10px 16px; margin-bottom: 20px; font-family: Verdana, Geneva, sans-serif; font-size: 8.5pt;">
        <t t-if="doc.client_order_ref">
          <p style="margin: 4px 0;"><span class="ter-lbl">Votre reference</span><span t-field="doc.client_order_ref"/></p>
        </t>
        <t t-if="doc.x_studio_delai_de_livraison">
          <p style="margin: 4px 0;"><span class="ter-lbl">Delai de livraison</span><span t-field="doc.x_studio_delai_de_livraison"/></p>
        </t>
        <t t-if="doc.incoterm">
          <p style="margin: 4px 0;"><span class="ter-lbl">Incoterm</span><strong style="color: #253758;"><span t-field="doc.incoterm.code"/></strong><span style="color: #949494;"> - </span><span t-field="doc.incoterm.name"/></p>
        </t>
        <t t-if="doc.payment_term_id">
          <p style="margin: 4px 0;"><span class="ter-lbl">Conditions de paiement</span><span t-field="doc.payment_term_id"/></p>
        </t>
      </div>
    </xpath>
  </data>

  <data>
    <xpath position="inside"
           expr="/t[@t-name='sale.report_saleorder_document_copy_10']//t[@t-call='web.external_layout']/div/div[9]/div"
           meta-class="oe_structure">
      <t t-if="doc.state not in ('sale', 'done', 'cancel')">
        <div style="margin-top: 30px; page-break-inside: avoid;">
          <div style="font-family: 'Century Gothic', Trebuchet MS, Arial, sans-serif; font-size: 7pt; color: #253758; text-transform: uppercase; letter-spacing: 1.5px; font-weight: bold; margin-bottom: 12px; border-bottom: 1px solid #D2CCC2; padding-bottom: 6px;">Bon pour accord - <span style="color: #C81628; font-size: 8pt;"><span t-field="doc.name"/></span></div>
          <table width="100%" style="border-collapse: collapse;">
            <tr>
              <td width="46%" style="vertical-align: top;">
                <div style="font-family: 'Century Gothic', Trebuchet MS, Arial, sans-serif; font-size: 7pt; color: #253758; text-transform: uppercase; letter-spacing: 1px; font-weight: bold; margin-bottom: 5px;">Cachet et signature du client</div>
                <div style="border: 1px solid #D2CCC2; border-top: 3px solid #253758; height: 72px; background-color: #FAF9F6;"></div>
                <div style="font-size: 7pt; color: #949494; font-style: italic; margin-top: 5px;">Preceder la signature de la mention Lu et approuve</div>
              </td>
              <td width="8%"></td>
              <td width="46%" style="vertical-align: top;">
                <div style="font-family: 'Century Gothic', Trebuchet MS, Arial, sans-serif; font-size: 7pt; color: #253758; text-transform: uppercase; letter-spacing: 1px; font-weight: bold; margin-bottom: 5px;">Date d acceptation</div>
                <div style="border: 1px solid #D2CCC2; border-top: 3px solid #253758; height: 72px; background-color: #FAF9F6;"></div>
                <div style="font-size: 7pt; color: #949494; font-style: italic; margin-top: 5px;">Date et lieu de signature</div>
              </td>
            </tr>
          </table>
        </div>
      </t>
    </xpath>
  </data>

</data>
