<t t-name="studio_customization.listing_commandes_par_semaine">
<t t-call="web.basic_layout">

    <!-- ── Variables globales ── -->
    <t t-set="edition_dt" t-value="datetime.datetime.now()"/>
    <t t-set="today_date"  t-value="edition_dt.date()"/>
    <t t-set="current_week_key" t-value="edition_dt.isocalendar()[0] * 100 + edition_dt.isocalendar()[1]"/>

    <!-- ── Données : commandes confirmées/verrouillées, non facturées ──
         Exclus : annulées, entièrement facturées, "opportunité incitative",
         et commandes dont TOUS les OF sont terminés (state = done/cancel).
         Les commandes sans OF sont conservées.
    -->
    <t t-set="filtered_docs" t-value="env['sale.order'].search([
        ('state', 'in', ['sale', 'done']),
        ('invoice_status', 'not in', ['invoiced', 'upselling']),
    ], order='name').filtered(
        lambda o: not o.mrp_production_ids
            or bool(o.mrp_production_ids.filtered(lambda mo: mo.state not in ('done', 'cancel')))
    )"/>

            <!-- ── Phase 1 : collecte des semaines uniques ──
                 Priorité : date_deadline des OF > commitment_date > date_order
            -->
            <t t-set="week_list" t-value="[]"/>
            <t t-foreach="filtered_docs" t-as="order">
                <t t-set="_mo_dl" t-value="order.mrp_production_ids.filtered(lambda mo: mo.date_deadline)"/>
                <t t-if="_mo_dl">
                    <t t-foreach="_mo_dl" t-as="mo">
                        <t t-set="_wk" t-value="mo.date_deadline.isocalendar()[0] * 100 + mo.date_deadline.isocalendar()[1]"/>
                        <t t-if="_wk not in week_list">
                            <t t-set="week_list" t-value="week_list + [_wk]"/>
                        </t>
                    </t>
                </t>
                <t t-elif="order.commitment_date">
                    <t t-set="_wk" t-value="order.commitment_date.isocalendar()[0] * 100 + order.commitment_date.isocalendar()[1]"/>
                    <t t-if="_wk not in week_list">
                        <t t-set="week_list" t-value="week_list + [_wk]"/>
                    </t>
                </t>
                <t t-elif="order.date_order">
                    <t t-set="_wk" t-value="order.date_order.isocalendar()[0] * 100 + order.date_order.isocalendar()[1]"/>
                    <t t-if="_wk not in week_list">
                        <t t-set="week_list" t-value="week_list + [_wk]"/>
                    </t>
                </t>
            </t>
            <t t-set="sorted_weeks" t-value="sorted(week_list)"/>

            <!-- ════════════════════════════════════════════════════════════ -->
            <div class="page">

                <!-- En-tête -->
                <div style="margin-bottom: 12px;">
                    <h2 style="margin: 0; font-size: 18px;">Commandes par semaine d'échéance</h2>
                    <div style="font-size: 11px; color: #555; margin-top: 3px;">
                        Édité le :
                        <strong>
                            <t t-esc="edition_dt.strftime('%d/%m/%Y')"/>
                            à
                            <t t-esc="edition_dt.strftime('%H:%M')"/>
                        </strong>
                        &#160;|&#160;
                        Semaine en cours : <strong>S<t t-esc="edition_dt.strftime('%V')"/></strong>
                        &#160;|&#160;
                        <t t-esc="len(filtered_docs)"/> commande(s) active(s)
                    </div>
                </div>

                <!-- Légende -->
                <div style="font-size: 10px; margin-bottom: 8px; padding: 3px 8px; background: #f8f9fa; border: 1px solid #dee2e6; display: inline-block; border-radius: 3px;">
                    Délai :
                    <span style="color: red; font-weight: bold;">■</span> Dépassé &#160;
                    <span style="color: darkorange; font-weight: bold;">■</span> Expire dans ≤ 2 jours &#160;
                    <span style="color: black;">■</span> OK &#160;
                    <span style="color: #2980b9;">■</span> Date de confirmation (sans échéance OF ni commande)
                </div>

                <!-- ── Tableau unique, un <tbody> par semaine ── -->
                <table class="table table-sm table-bordered"
                       style="width: 100%; font-size: 11px; border-collapse: collapse; margin-top: 4px;">

                    <!-- En-tête de colonnes (répété sur chaque page par wkhtmltopdf) -->
                    <thead>
                        <tr style="background-color: #eff2f5; color: #222;">
                            <th style="width: 5%;  text-align: center;">Semaine</th>
                            <th style="width: 2%;  text-align: center;">#</th>
                            <th style="width: 7%;">N° Cde</th>
                            <th style="width: 5%;">Date</th>
                            <th style="width: 12%;">Société</th>
                            <th style="width: 29%;">Réf. client</th>
                            <th style="width: 8%;">Échéance</th>
                            <th style="width: 32%;">N° OF</th>
                        </tr>
                    </thead>

                    <!-- Un <tbody> par semaine → page-break-inside: avoid sur le groupe -->
                    <t t-foreach="sorted_weeks" t-as="week_key">
                        <t t-set="week_num"  t-value="week_key % 100"/>
                        <t t-set="week_year" t-value="str(week_key // 100)[2:]"/>

                        <!-- Semaine en cours = bleu ; autres = gris clair / blanc alternés -->
                        <t t-set="_is_current" t-value="week_key == current_week_key"/>
                        <t t-set="_hdr_bg" t-value="'background-color:#1a5276;color:white;' if _is_current else ('background-color:#d8d8d8;color:#333;' if week_key_index % 2 == 0 else 'background-color:#e8e8e8;color:#333;')"/>
                        <t t-set="_row_bg" t-value="'background-color:#eef5fb;' if _is_current else ('background-color:#f4f4f4;' if week_key_index % 2 == 0 else '')"/>

                        <!-- Commandes de cette semaine -->
                        <t t-set="week_orders" t-value="filtered_docs.filtered(lambda o:
                            bool(o.mrp_production_ids.filtered(lambda mo: mo.date_deadline and mo.date_deadline.isocalendar()[0] * 100 + mo.date_deadline.isocalendar()[1] == week_key))
                            or (not o.mrp_production_ids.filtered(lambda mo: mo.date_deadline) and o.commitment_date and o.commitment_date.isocalendar()[0] * 100 + o.commitment_date.isocalendar()[1] == week_key)
                            or (not o.mrp_production_ids.filtered(lambda mo: mo.date_deadline) and not o.commitment_date and o.date_order and o.date_order.isocalendar()[0] * 100 + o.date_order.isocalendar()[1] == week_key)
                        )"/>
                        <t t-set="n_rows" t-value="len(week_orders)"/>

                        <tbody style="page-break-inside: avoid;">
                            <t t-foreach="week_orders" t-as="order">

                                <!-- OF de cette commande dans cette semaine -->
                                <t t-set="_wmos" t-value="order.mrp_production_ids.filtered(
                                    lambda mo: mo.date_deadline and
                                    mo.date_deadline.isocalendar()[0] * 100 + mo.date_deadline.isocalendar()[1] == week_key
                                )"/>

                                <tr t-att-style="_row_bg">

                                    <!-- ── Cellule "Semaine" fusionnée (1re ligne du groupe) ── -->
                                    <t t-if="order_first">
                                        <td t-att-rowspan="n_rows"
                                            t-att-style="_hdr_bg + 'text-align:center; vertical-align:middle; padding: 6px 4px;'">
                                            <span style="font-size: 13px; font-weight: bold; display: block;">
                                                S<t t-esc="week_num"/> / <t t-esc="week_year"/>
                                            </span>
                                            <span style="font-size: 9px; font-weight: normal; display: block; margin-top: 4px;">
                                                (<t t-esc="n_rows"/> Cmde(s))
                                            </span>
                                        </td>
                                    </t>

                                    <!-- # dans la semaine -->
                                    <td style="text-align: center;">
                                        <t t-esc="order_index + 1"/>
                                    </td>

                                    <!-- N° commande -->
                                    <td><strong><t t-esc="order.name"/></strong></td>

                                    <!-- Date commande -->
                                    <td>
                                        <t t-if="order.create_date">
                                            <t t-esc="order.create_date.strftime('%d/%m/%y')"/>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>

                                    <!-- Société -->
                                    <td>
                                        <t t-if="order.partner_id and order.partner_id.commercial_company_name">
                                            <t t-esc="order.partner_id.commercial_company_name"/>
                                        </t>
                                        <t t-elif="order.partner_id">
                                            <t t-esc="order.partner_id.name"/>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>

                                    <!-- Réf. client -->
                                    <td><t t-esc="order.client_order_ref or '-'"/></td>

                                    <!-- ── Échéance(s) ── -->
                                    <td>
                                        <t t-if="_wmos">
                                            <t t-set="_seen" t-value="[]"/>
                                            <t t-foreach="_wmos" t-as="mo">
                                                <t t-if="mo.date_deadline">
                                                    <t t-set="_ds"   t-value="mo.date_deadline.strftime('%d/%m/%y')"/>
                                                    <t t-if="_ds not in _seen">
                                                        <t t-set="_seen"  t-value="_seen + [_ds]"/>
                                                        <t t-set="_dd"   t-value="mo.date_deadline.date()"/>
                                                        <t t-set="_diff" t-value="(_dd - today_date).days"/>
                                                        <t t-set="_col"  t-value="'color:red;font-weight:bold;' if _diff &lt; 0 else ('color:darkorange;font-weight:bold;' if _diff &lt;= 2 else 'color:black;')"/>
                                                        <span t-att-style="_col"><t t-esc="_ds"/></span><br/>
                                                    </t>
                                                </t>
                                            </t>
                                        </t>
                                        <t t-elif="order.commitment_date">
                                            <t t-set="_cd"   t-value="order.commitment_date.date()"/>
                                            <t t-set="_diff" t-value="(_cd - today_date).days"/>
                                            <t t-set="_col"  t-value="'color:red;font-weight:bold;' if _diff &lt; 0 else ('color:darkorange;font-weight:bold;' if _diff &lt;= 2 else 'color:black;')"/>
                                            <span t-att-style="_col">
                                                <t t-esc="order.commitment_date.strftime('%d/%m/%y')"/>
                                            </span>
                                        </t>
                                        <t t-else="">
                                            <!-- Fallback date_order en bleu -->
                                            <span style="color: #2980b9;">
                                                <t t-if="order.date_order">
                                                    <t t-esc="order.date_order.strftime('%d/%m/%y')"/>
                                                </t>
                                                <t t-else="">-</t>
                                            </span>
                                        </t>
                                    </td>

                                    <!-- ── N° OF ── -->
                                    <td>
                                        <t t-if="_wmos">
                                            <t t-if="len(_wmos) &lt;= 4">
                                                <t t-esc="', '.join(_wmos.mapped('name'))"/>
                                            </t>
                                            <t t-else="">
                                                <t t-foreach="_wmos" t-as="mo">
                                                    <t t-esc="mo.name"/>
                                                    <t t-if="not mo_last">, </t>
                                                    <t t-if="(mo_index + 1) % 4 == 0 and not mo_last"><br/></t>
                                                </t>
                                            </t>
                                        </t>
                                        <t t-elif="order.mrp_production_ids">
                                            <t t-if="len(order.mrp_production_ids) &lt;= 4">
                                                <t t-esc="', '.join(order.mrp_production_ids.mapped('name'))"/>
                                            </t>
                                            <t t-else="">
                                                <t t-foreach="order.mrp_production_ids" t-as="mo">
                                                    <t t-esc="mo.name"/>
                                                    <t t-if="not mo_last">, </t>
                                                    <t t-if="(mo_index + 1) % 4 == 0 and not mo_last"><br/></t>
                                                </t>
                                            </t>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>

                                </tr>
                            </t><!-- fin week_orders -->
                        </tbody>

                    </t><!-- fin sorted_weeks -->

                </table>

                <!-- Pied de page -->
                <div style="margin-top: 14px; border-top: 1px solid #ccc; padding-top: 4px;">
                    <table style="width: 100%; font-size: 10px; color: #666;">
                        <tr>
                            <td style="width: 40%; text-align: left;">
                                <t t-if="company and company.name">
                                    <t t-esc="company.name"/>
                                </t>
                                <t t-else="">Généré avec Odoo</t>
                            </td>
                            <td style="width: 60%; text-align: right;">
                                Semaine <t t-esc="edition_dt.strftime('%V')"/> —
                                <t t-esc="edition_dt.strftime('%d/%m/%Y à %H:%M')"/>
                            </td>
                        </tr>
                    </table>
                </div>

            </div><!-- end .page -->

</t><!-- end web.basic_layout -->

</t>
