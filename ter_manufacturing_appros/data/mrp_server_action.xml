<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action serveur : Marquer Appros (cocher x_studio_appros = True) -->
    <record id="action_mrp_mark_appros" model="ir.actions.server">
        <field name="name">Marquer Appros</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.write({'x_studio_appros': True})</field>
    </record>

    <!-- Action serveur : Démarquer Appros (décocher x_studio_appros = False) -->
    <record id="action_mrp_unmark_appros" model="ir.actions.server">
        <field name="name">Démarquer Appros</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.write({'x_studio_appros': False})</field>
    </record>

</odoo>
